{
  "name": "photoframe",
  "version": "1.0.0",
  "description": "> 胶片照片加边框排版工具，专为胶片摄影爱好者打造。",
  "private": true,
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "vendor": "node scripts/sync-vendor.mjs",
    "test": "playwright test",
    "test:smoke": "playwright test tests/smoke.spec.js",
    "check": "node --check js/app.js && node --check js/canvas-renderer.js && node --check js/collage-layouts.js && node --check js/image-decoder.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JackerKun/PhotoFrame.git"
  },
  "keywords": ["photo", "frame", "canvas", "offline", "film"],
  "author": "JackerKun",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/JackerKun/PhotoFrame/issues"
  },
  "homepage": "https://github.com/JackerKun/PhotoFrame#readme",
  "dependencies": {
    "exifr": "^7.1.3",
    "file-saver": "^2.0.5",
    "heic2any": "^0.0.4",
    "jszip": "^3.10.1",
    "@playwright/test": "^1.59.1",
    "utif": "^3.1.0"
  },
  "devDependencies": {
    "@mapbox/vector-tile": "2.0.5",
    "pbf": "4.0.2"
  }
}
